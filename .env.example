GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
APP_HOST=0.0.0.0
APP_PORT=8000
SYSTEM_PROMPT="You are a helpful assistant. Answer clearly and briefly."
SUMMARY_THRESHOLD=10

# --- Memory Settings ---
VECTOR_DB_PATH=memory/vector_index
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
SIMILARITY_THRESHOLD=0.7
TOP_K_ASSOCIATIVE=3
IDENTITY_UPDATE_INTERVAL=10
DECAY_LAMBDA=0.03

# --- Inner Monologue System (Phase B/C) ---
INNER_LOOP_ENABLED=true              # Master on/off switch for background thinking
INNER_LOOP_INTERVAL=300              # Seconds between thought cycles (default: 5 min)
INNER_THOUGHT_SALIENCE=0.3          # Starting salience for new thoughts (low — must earn reinforcement)
INNER_THOUGHT_MAX_COUNT=20          # Max stored inner thoughts before pruning oldest
INNER_THOUGHT_DECAY_MULT=2.0        # Decay multiplier (thoughts fade faster than regular memories)
INNER_THOUGHT_INJECT_THRESHOLD=0.6  # Similarity threshold for injecting thoughts into prompt
